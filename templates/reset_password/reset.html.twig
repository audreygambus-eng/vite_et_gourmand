{% extends 'base.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block body %}
    <div class="row justify-content-center mt-4">
        <div class="col-md-6">
            <p class="label-eyebrow text-center">NOUVEAU MOT DE PASSE</p>
            <h1 class="text-center mb-4">Réinitialiser votre mot de passe</h1>

            {{ form_start(resetForm, {attr: {class: 'formulaire-espace'}}) }}
                {{ form_row(resetForm.plainPassword) }}
                <p class="caption-meta mb-3">
                    Votre mot de passe doit contenir au moins 10 caractères, une majuscule, une minuscule, un chiffre et un caractère spécial
                </p>
                <button class="btn btn-primary w-100 mt-3">Réinitialiser le mot de passe</button>
            {{ form_end(resetForm) }}
        </div>
    </div>
{% endblock %}