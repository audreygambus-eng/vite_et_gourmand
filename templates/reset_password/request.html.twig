{% extends 'base.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block body %}
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}

    <div class="row justify-content-center mt-4">
        <div class="col-md-6">
            <p class="label-eyebrow text-center">MOT DE PASSE OUBLIÉ</p>
            <h1 class="text-center mb-4">Réinitialiser votre mot de passe</h1>

            {{ form_start(requestForm, {attr: {class: 'formulaire-espace'}}) }}
                {{ form_row(requestForm.email) }}
                <p class="caption-meta">
                    Veuillez renseigner votre adresse mail pour recevoir le lien de réinitialisation.
                </p>

                <button class="btn btn-primary w-100 mt-3">Envoyer le mail de réinitialisation</button>
            {{ form_end(requestForm) }}
        </div>
    </div>
{% endblock %}