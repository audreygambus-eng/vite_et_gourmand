<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Vite & Gourmand{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Playfair+Display:wght@400;700&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" integrity="sha384-tViUnnbYAV00FLIhhi3v/dWt3Jxw4gZQcNoSCxCIFNJVCx7/D55/wXsrNIRANwdD" crossorigin="anonymous">        <link rel="stylesheet" href="{{ asset('css/charte-graphique.css') }}">
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    
    <body>
        <nav class="navbar navbar-expand-lg" style="background-color: var(--background-card); border-bottom: 1px solid var(--border-soft);">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_accueil') }}" style="display: flex; flex-direction: column; line-height: 1.2;">
                    <span>Vite <span style="color: var(--primary-brand);">&</span> Gourmand</span>
                    <span style="font-size: 11px; font-weight: 400; color: var(--text-secondary); letter-spacing: 1px;">TRAITEUR - BORDEAUX</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link nav-link-accueil" href="{{ path('app_accueil') }}">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_menu') }}">Nos menus</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_contact') }}">Contact</a>
                        </li>

                        {% if app.user %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_espace_admin') }}">Espace administrateur</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_espace_employe') }}">Espace employé</a>
                                </li>
                            {% elseif is_granted('ROLE_EMPLOYE') %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_espace_employe') }}">Espace employé</a>
                                </li>
                            {% else %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_espace_utilisateur_profil') }}">Mon profil</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_espace_utilisateur') }}">Mes commandes</a>
                                </li>
                            {% endif %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_logout') }}">Déconnexion</a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="btn btn-primary btn-primary-regular" href="{{ path('app_login') }}">Connexion/Inscription</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <main class="container my-4">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

        {% block body %}{% endblock %}
        </main>

        <footer style="background-color: var(--text-primary); padding: var(--spacing-xl) 0; margin-top: var(--spacing-3xl);">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <p style="font-family: var(--font-logo); font-weight: 700; color: white; margin-bottom: 4px;">
                        Vite <span style="color: var(--accent);">&</span> Gourmand
                    </p>
                    <p class="caption-meta" style="color: var(--background-soft);">TRAITEUR - BORDEAUX</p>
                </div>
                <div class="col-md-4 mb-4">
                    <p class="label-eyebrow" style="color: var(--accent);">HORAIRES</p>
                    {% for horaire in horaires() %}
                        <p style="color: var(--background-soft); font-size: 13px; margin-bottom: 2px;">{{ horaire.jour }} : {{ horaire.heureOuverture }} - {{ horaire.heureFermeture }}</p>
                    {% endfor %}
                </div>
                <div class="col-md-4 mb-4">
                    <p class="label-eyebrow" style="color: var(--accent);">LIENS</p>
                    <p><a href="{{ path('app_mentions_legales') }}" style="color: var(--background-soft); text-decoration: none;">Mentions légales</a></p>
                    <p><a href="{{ path('app_cgv') }}" style="color: var(--background-soft); text-decoration: none;">Conditions générales de vente</a></p>
                </div>
            </div>
            <hr style="border-color: rgba(255,255,255,0.1); margin: var(--spacing-md) 0;">
            <p class="text-center caption-meta" style="color: var(--background-soft);">© 2026 Vite & Gourmand. Tous droits réservés.</p>
        </div>
</footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    </body>
</html>