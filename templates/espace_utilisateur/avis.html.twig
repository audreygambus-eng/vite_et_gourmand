{% extends 'base.html.twig' %}

{% block title %}Laisser un avis - Vite & Gourmand{% endblock %}

{% block body %}
    <a href="{{ path('app_espace_utilisateur_commande_detail', {id: commande.id}) }}" class="btn btn-outline-secondary mb-4">← Retour à la commande</a>

    <p class="label-eyebrow">VOTRE AVIS</p>
    <h1>Laisser un avis</h1>
    <p class="caption-meta mb-4">Menu : {{ commande.menu.titre }}</p>

    {{ form_errors(form) }}

    {{ form_start(form, {attr: {class: 'formulaire-espace'}}) }}
        {{ form_row(form.note) }}
        {{ form_row(form.commentaire) }}

        <button type="submit" class="btn btn-primary w-100 mt-3">Envoyer mon avis</button>
    {{ form_end(form) }}
{% endblock %}