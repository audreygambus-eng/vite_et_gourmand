{% extends 'base.html.twig' %}

{% block title %}Commande {{ commande.numeroCommande }} - Vite & Gourmand{% endblock %}

{% block body %}
    <a href="{{ path('app_espace_utilisateur')}}" class="btn btn-outline-secondary mb-4">← Retour à mes commandes</a>

    <p class="label-eyebrow">COMMANDE</p>
    <h1>{{ commande.numeroCommande }}</h1>

    <div class="row mt-4">
        <div class="col-md-6">
            <div class="carte-contenu">
                <h3 class="card-title-dark mb-3">Détails</h3>
                <p><strong>Menu :</strong> {{ commande.menu.titre }}</p>
                <p><strong>Nombre de personnes :</strong> {{ commande.nbPersonnes }}</p>
                <p><strong>Date de prestation :</strong> {{ commande.datePrestation|date('d/m/Y') }}</p>
                <p><strong>Heure de livraison :</strong> {{ commande.heureLivraison }}</p>
                <p><strong>Adresse :</strong> {{ commande.adresseLivraison }}, {{ commande.villeLivraison }}</p>
                <p><strong>Prix menu :</strong> {{ commande.prixMenu }} €</p>
                <p><strong>Frais de livraison :</strong> {{ commande.prixLivraison }} €</p>
                <p style="font-weight: 700; font-size: 19px;"><strong>Total :</strong> <span style="color: var(--primary-brand);">{{ commande.prixTotal }} €</span></p>

                {% if commande.estModifiable %}
                    <div class="mt-3 pt-3" style="border-top: 1px solid var(--border-soft);">
                        <a href="{{ path('app_espace_utilisateur_commande_modifier', {id: commande.id})}}" class="btn btn-primary">Modifier</a>
                        <form method="post" action="{{ path('app_espace_utilisateur_commande_annuler', {id: commande.id}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûre de vouloir annuler cette commande ?');">
                            <button type="submit" class="btn btn-danger">Annuler la commande</button>
                        </form>
                    </div>
                {% elseif commande.estTerminee and commande.avis is null %}
                    <div class="mt-3 pt-3" style="border-top: 1px solid var(--border-soft);">
                        <a href="{{ path('app_espace_utilisateur_avis', {id: commande.id}) }}" class="btn btn-primary">Laisser un avis</a>
                    </div>
                {% else %}
                    <p class="caption-meta mt-3">Cette commande a été acceptée et ne peut donc plus être modifiée ni annulée.</p>
                {% endif %}
            </div>
        </div>

        <div class="col-md-6" style="padding-left: var(--spacing-lg);">
            <div class="carte-contenu">
                <h3 class="card-title-dark mb-3">Suivi de la commande</h3>
                {% if commande.statutHistoriques is empty %}
                    <p style="color: var(--text-secondary);">Aucun historique n'est disponible.</p>
                {% else %}
                    {% for statut in commande.statutHistoriques %}
                        <div class="mb-3 pb-3" style="border-bottom: 1px solid var(--border-soft);">
                            <span class="badge-verifie">{{ statut.statut }}</span>
                            <p class="caption-meta mt-1 mb-0">{{ statut.dateModification|date('d/m/Y H:i') }}</p>
                            {% if statut.commentaire %}
                                <p class="caption-meta mt-1 mb-0">{{ statut.commentaire }}</p>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}