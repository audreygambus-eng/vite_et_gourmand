{% extends 'base.html.twig' %}

{% block title %}Contact - Vite & Gourmand{% endblock %}

{% block body %}
    <div class="row justify-content-center mt-4">
        <div class="col-md-8">
            <p class="label-eyebrow text-center">CONTACT</p>
            <h1 class="text-center mb-4">Vous avez des questions ? Contactez-nous !</h1>

            {{ form_errors(form) }}

            {{ form_start(form, {attr: {class: 'formulaire-espace'}}) }}
                {{ form_row(form.titre) }}
                {{ form_row(form.email) }}
                {{ form_row(form.description) }}

                <button type="submit" class="btn btn-primary w-100 mt-3">Envoyer</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}