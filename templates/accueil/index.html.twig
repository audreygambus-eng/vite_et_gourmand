{% extends 'base.html.twig' %}

{% block title %}Accueil - Vite & Gourmand{% endblock %}

{% block body %}
    <section class="text-center py-5">
        <h1>Bienvenue chez Vite & Gourmand</h1>
        <p class="lead">Traiteur implanté sur Bordeaux depuis 25 ans</p>
    </section>

    <section class="py-5">
        <div class="row">
            <div class="col-md-6">
                <h2>Notre savoir-faire</h2>
                <p>
                    Passionnés par leur métier depuis 25 ans, Julie et José mettent leur savoir-faire au service de vos événements.
                    <br>Réunions familiales, grandes réceptions, événements d'entreprise, chaque occasion est unique et mérite l'excellence. Pour répondre à cette exigence, notre équipe compose
                    des menus sur-mesure avec des produits frais et de saison.
                </p>
            </div>
            <div class="col-md-6">
                <h2>Une équipe de professionnels</h2>
                <p>
                    Experts culinaires reconnus, notre engagement à proposer un service de qualité fait de nous le meilleur partenaire de confiance
                    pour vos événements sur Bordeaux et ses alentours.
                </p>
            </div>
        </div>
    </section>

    <section class="py-5">
        <h2 class="text-center mb-4">Ils nous ont fait confiance</h2>

        {% if avis is empty %}
            <p class="text-center text-muted">Aucun avis pour le moment.</p>
        {% else %}
            <div class="row">
                {% for item in avis %}
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="mb-2">
                                    {% for i in 1..5 %}
                                        {% if i <= item.note %}★{% else %}☆{% endif %}
                                    {% endfor %}
                                </div>
                                <p class="card-text">{{ item.commentaire }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
