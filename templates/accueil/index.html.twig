{% extends 'base.html.twig' %}

{% block title %}Accueil - Vite & Gourmand{% endblock %}

{% block body %}
    {# Hero Section #}
    <div class="row g-0 hero-section">
        <div class="col-md-6 hero-content">
            <p class="label-eyebrow" style="color: white;">Traiteur depuis 25ans</p>
            <h1 class="hero-title" style="color: white;">
                Vos événements<br>méritent d'être<br><span style="color: var(--accent);">savoureux.</span>
            </h1>
            <p style="color: white; line-height: 1.7;">Julie et José créent des menus sur mesure pour chaque occasion, Noël, Pâques, anniversaires, mariages, baptêmes... Simple, généreux et mémorable depuis 25 ans.</p>
            <a href="{{ path('app_menu') }}" class="hero-cta">Nos menus</a>
        </div>
        <div class="col-md-6 image-container"><img src="{{ (asset('images/hero-img.png')) }}" alt="Amuses-bouche"/></div>
    </div>

    {# Section Entreprise #}
    <div class="row g-0 section-entreprise">
        <div class="col-md-6 image-container"><img src="{{ (asset('images/entreprise-img.png')) }}" alt="Fondateurs"/></div>
        <div class="col-md-6 section-entreprise-content">
            <p class="label-eyebrow">L'ENTREPRISE</p>
            <h2>Une maison <span style="color: var(--primary-brand);">familiale</span> à Bordeaux</h2>
            <p style="color: var(--text-secondary); line-height: 1.75;">
                Vite & Gourmand, c'est l'histoire de Julie et José, deux passionnés de cuisine qui ont décidé, il y a plus de 25 ans, de transformer leur amour du bon repas en métier.
                <br><br>
                Implantés à Bordeaux, ils proposent leurs prestations pour tous types d'événements : du simple repas de Noël en famille au dîner de gala en entreprise, en passant par les célébrations de Pâques, anniversaires et mariages.
                <br><br>
                Leur signature ? Des menus en constante évolution, composés selon les saisons et le marché, pensés pour que chaque table soit un moment inoubliable.
            </p>
            <div class="fondateur-card">
                <div class="fondateur-avatars">
                    <div class="avatar-circle avatar-circle-primary">J</div>
                    <div class="avatar-circle avatar-circle-dark">J</div>
                </div>
                <div>
                    <p class="mb-0" style="font-weight: 700;">Julie & José</p>
                    <p class="mb-0 caption-meta">Fondateurs · Chefs traiteurs · Bordeaux</p>
                </div>
            </div>
        </div>
    </div>

    {# Section Expertise #}
    <div class="row g-0 section-expertise">
        <div class="col-12">
            <div class="expertise-fond-sombre">
                <div class="text-center mb-5">
                    <p class="label-eyebrow">NOTRE EXPERTISE</p>
                    <h2 style="color: white;">25 ans de savoir-faire,<br><span style="color: var(--accent);">à votre service.</span></h2>
                    <p style="color: var(--background-soft); max-width: 700px; margin: 0 auto;">Julie et José mettent leur expérience au service de chaque événement, du plus intime au plus grand.</p>
                </div>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="expertise-card">
                            <h3 class="card-title-dark mt-3">25 ans de savoir-faire bordelais</h3>
                            <p class="expertise-card-text">Depuis 1999, Julie et José ont cuisiné pour des centaines d'événements, des plus intimes aux plus grands. Cette expérience se ressent dans chaque assiette, chaque détail, chaque organisation.</p>
                            <hr style="border-color: var(--border-soft);">
                            <span class="caption-meta expertise-badge">Fondée en 1999 · Bordeaux</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="expertise-card">
                            <h3 class="card-title-dark mt-3">Des produits frais, sourcés localement</h3>
                            <p class="expertise-card-text">Chaque menu est composé selon la saison et les arrivages du marché. Julie et José travaillent en direct avec des producteurs girondins pour garantir fraîcheur, traçabilité et authenticité.</p>
                            <hr style="border-color: var(--border-soft);">
                            <span class="caption-meta expertise-badge">100% fait maison · Produits locaux</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="expertise-card">
                            <h3 class="card-title-dark mt-3">Un service fiable, du devis à la table</h3>
                            <p class="expertise-card-text">Ponctualité, hygiène HACCP, installation et service sur place, Julie et José prennent en charge l'intégralité de la prestation pour que vous n'ayez qu'une seule chose à faire : profiter.</p>
                            <hr style="border-color: var(--border-soft);">
                            <span class="caption-meta expertise-badge">Certification HACCP · Livraison incluse</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Section Avis #}
    <div class="section-avis">
        <div class="text-center mb-4">
            <p class="label-eyebrow">AVIS CLIENTS</p>
            <h2>Ce que disent <span style="color: var(--primary-brand);">nos clients</span></h2>
            <p style="color: var(--text-secondary);">Tous nos avis sont vérifiés et proviennent de clients ayant réellement fait appel à nos services.</p>
        </div>

        <p class="text-center mb-4">
            <span style="font-family: var(--font-body); font-weight: 700; font-size: 32px;">4,9 </span>
            <span class="star-rating">★★★★★</span>
            <span> sur 124 avis vérifiés</span>
        </p>

        {% if avis is empty %}
            <p class="text-center text-muted">Aucun avis pour le moment.</p>
        {% else %}
            <div class="row">
                {% for item in avis %}
                    <div class="col-md-4 mb-4">
                        <div class="card-avis" style="padding: var(--spacing-md);">
                            <div class="avis-header">
                                <div class="avis-utilisateur">
                                    <div class="avis-avatar">{{ item.commande.utilisateur.prenom|first|upper }}</div>
                                    <div>
                                        <p class="mb-0" style="font-weight: 700; font-size: 11px;">{{ item.commande.utilisateur.prenom }} {{ item.commande.utilisateur.nom }}</p>
                                        <p class="mb-0 star-rating" style="font-size: 12px;">★★★★★</p>
                                    </div>
                                </div>
                                <span class="avis-badge-verifie">Vérifié</span>
                            </div>
                            <p class="avis-commentaire">{{ item.commentaire }}</p>
                            <p class="caption-meta mt-2">{{ item.dateCreation|date('d/m/Y') }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}