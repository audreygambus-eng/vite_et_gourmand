{% extends 'base.html.twig' %}

{% block title %}{{ menu.titre }} - Vite & Gourmand{% endblock %}

{% block body %}
    <a href="{{ path('app_menu') }}" class="btn btn-outline-secondary mb-4">← Retour aux menus</a>

    <div class="row">
        <div class="col-md-6">
            <h1>{{ menu.titre }}</h1>
            <p class="text-muted">
                {{ menu.theme.libelle }} — {{ menu.regime.libelle }}
            </p>

            <p>{{ menu.description }}</p>

            <p class="fw-bold fs-4">{{ menu.prixBase }} € / personne</p>

            <p>À partir de {{ menu.nbPersonnesMin }} personnes</p>

            {% if menu.conditions %}
                <div class="alert alert-warning">
                    <strong>Conditions :</strong> {{ menu.conditions }}
                </div>
            {% endif %}

            <p>
                <span class="badge {% if menu.stockDisponible > 0 %}bg-success{% else %}bg-danger{% endif %}">
                    {% if menu.stockDisponible > 0 %}
                        {{ menu.stockDisponible }} commandes possibles
                    {% else %}
                        Stock épuisé
                    {% endif %}
                </span>
            </p>

            <a href="{{ path('app_commande_nouvelle', {menuId: menu.id}) }}" class="btn btn-primary btn-lg">Commander</a>
        </div>

        <div class="col-md-6">
            <h2>Composition du menu</h2>
            {% if menu.plats is empty %}
                <p class="text-muted">Aucun plat renseigné pour ce menu.</p>
            {% else %}
                {% for plat in menu.plats %}
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">{{ plat.titre }}</h5>
                            <p class="text-muted text-uppercase small">{{ plat.type }}</p>
                            <p class="card-text">{{ plat.description }}</p>

                            {% if plat.allergenes is not empty %}
                                <p class="small text-danger">
                                    Allergènes :
                                    {% for allergene in plat.allergenes %}
                                        {{ allergene.libelle }}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </p>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>

    {% if menu.images is not empty %}
        <h2 class="mt-5">Galerie</h2>
        <div id="carouselMenu" class="carousel slide mb-4" data-bs-ride="carousel">
            <div class="carousel-inner">
                {% for image in menu.images %}
                    <div class="carousel-item {% if loop.first %}active{% endif %}">
                        <img src="{{ asset('uploads/menus/' ~ image.url) }}" class="d-block w-100" alt="{{ menu.titre }}">
                    </div>
                {% endfor %}
            </div>
            {% if menu.images|length > 1 %}
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselMenu" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselMenu" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}