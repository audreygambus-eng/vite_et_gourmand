{% extends 'base.html.twig' %}

{% block title %}Nos menus - Vite & Gourmand{% endblock %}

{% block body %}
    <div class="mb-5">
        <p class="label-eyebrow text-start">NOS MENUS</p>
        <h1 class="text-start">Des menus pensés pour <span style="color: var(--primary-brand);">chaque occasion</span></h1>
        <p class="text-start">Des créations de saison, élaborées avec des produits frais et locaux, </br> pour sublimer tous vos événements privés et professionnels à Bordeaux et ses alentours</p>
    </div>

    <form id="filtres-menus" class="row g-3 mb-5 bloc-filtres"
        data-url-filtre="{{ path('app_menu_filter') }}"
        data-url-detail-base="{{ path('app_menu_detail', {id: 0}) }}">
        <div class="col-md-3">
            <label for="prixMax" class="form-label">Prix maximum</label>
            <input type="number" class="form-control" id="prixMax" name="prixMax" step="0.01">
        </div>

        <div class="col-md-3">
            <label for="theme" class="form-label">Thème</label>
            <select class="form-select" id="theme" name="theme">
                <option value="">Tous les thèmes</option>
                {% for theme in themes %}
                    <option value="{{ theme.id }}">{{ theme.libelle }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            <label for="regime" class="form-label">Régime</label>
            <select class="form-select" id="regime" name="regime">
                <option value="">Tous les régimes</option>
                {% for regime in regimes %}
                    <option value="{{ regime.id }}">{{ regime.libelle }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            <label for="nbPersonnes" class="form-label">Nombre de personnes minimum</label>
            <input type="number" class="form-control" id="nbPersonnes" name="nbPersonnes">
        </div>
    </form>

    <div id="liste-menus" class="row">
        {% if menus is empty %}
            <p class="text-center" style="color: var(--text-secondary);">Aucun menu disponible pour le moment.</p>
        {% else %}
            {% for menu in menus %}
                <div class="col-md-4 mb-4">
                        <div class="carte-menu h-100">
                            {% if menu.images is not empty %}
                                <img src="{{ vich_uploader_asset(menu.images|first, 'fichier') }}" class="carte-menu-image" alt="{{ menu.titre }}">
                            {% else %}
                                <div class="carte-menu-image carte-menu-image-placeholder"></div>
                            {% endif %}
                            <div class="carte-menu-body">
                                <h2 class="card-title-dark">{{ menu.titre }}</h2>
                                <p class="description-menu" style="color: var(--text-secondary);">{{ menu.description }}</p>
                                <p class="caption-meta">À partir de {{ menu.nbPersonnesMin }} personnes</p>
                                <p style="font-weight: 700; font-size: 19px;">
                                    <span style="color: var(--primary-brand);">{{ menu.prixBase }} €</span>
                                    <span style="color: var(--text-primary);"> / personne</span>
                                </p>
                                <a href="{{ path('app_menu_detail', {id: menu.id}) }}" class="btn btn-primary">Voir le détail</a>
                            </div>
                        </div>
                    </div>
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/menu-filtres.js') }}"></script>
{% endblock %}
