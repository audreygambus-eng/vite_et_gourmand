{% extends 'base.html.twig' %}

{% block title %}Espace administrateur - Vite & Gourmand{% endblock %}

{% block body %}
    <p class="label-eyebrow">ESPACE ADMINISTRATEUR</p>
    <h1>Bienvenue dans votre <span style="color: var(--primary-brand);">espace</span></h1>
    <p style="color: var(--text-secondary);">Gérez les comptes employés et consultez les statistiques de Vite & Gourmand.</p>

    <div class="row mt-5 g-4">
        <div class="col-md-6">
            <a href="{{ path('app_espace_admin_employes') }}" class="carte-dashboard" style="padding: var(--spacing-lg); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <div style="width: 56px; height: 56px; background-color: var(--background-soft); border-radius: var(--radius-card-avis); display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-sm);">
                    <i class="bi bi-people" style="font-size: 28px; color: var(--primary-brand);"></i>
                </div>
                <h2 class="card-title-dark" style="font-size: 24px;">Employés</h2>
                <p class="caption-meta">Créer et gérer les comptes</p>
            </a>
        </div>
        <div class="col-md-6">
            <a href="{{ path('app_espace_admin_statistiques') }}" class="carte-dashboard" style="padding: var(--spacing-lg); min-height: 200px; display: flex; flex-direction: column; justify-content: center;">
                <div style="width: 56px; height: 56px; background-color: var(--background-soft); border-radius: var(--radius-card-avis); display: flex; align-items: center; justify-content: center; margin-bottom: var(--spacing-sm);">
                    <i class="bi bi-bar-chart" style="font-size: 28px; color: var(--primary-brand);"></i>
                </div>
                <h3 class="card-title-dark" style="font-size: 24px;">Statistiques</h3>
                <p class="caption-meta">Consulter le CA et les tendances</p>
            </a>
        </div>
    </div>
{% endblock %}
