{% extends 'base.html.twig' %}

{% block title %}Créer un compte employé - Vite & Gourmand{% endblock %}

{% block body %}
    <a href="{{ path('app_espace_admin_employes') }}" class="btn btn-outline-secondary mb-4">← Retour aux employés</a>

    <p class="label-eyebrow">NOUVEAU COMPTE</p>
    <h1>Créer un compte employé</h1>

    {{ form_errors(form) }}

    {{ form_start(form, {attr: {class: 'formulaire-espace mt-4'}}) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.prenom) }}
        {{ form_row(form.email) }}
        {{ form_row(form.telephone) }}
        {{ form_row(form.plainPassword) }}
        <p class="caption-meta mb-3">
            Votre mot de passe doit contenir au moins 10 caractères, une majuscule, une minuscule, un chiffre et un caractère spécial
        </p>

        <button type="submit" class="btn btn-primary w-100 mt-3">Créer le compte</button>
    {{ form_end(form) }}
{% endblock %}