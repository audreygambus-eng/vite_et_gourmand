{% extends 'base.html.twig' %}

{% block title %}Gestion des avis - Vite & Gourmand{% endblock %}

{% block body %}
    <a href="{{ path('app_espace_employe') }}" class="btn btn-outline-primary mb-4">← Retour à votre espace</a>

    <p class="label-eyebrow">GESTION</p>
    <h1>Avis en <span style="color: var(--primary-brand);">attente</span></h1>

    {% if avisEnAttente is empty %}
        <p style="color: var(--text-secondary);" class="mt-4">Aucun avis en attente pour le moment.</p>
    {% else %}
        <div class="row mt-4">
            {% for avis in avisEnAttente %}
                <div class="col-md-6 mb-4">
                    <div class="carte-plat h-100">
                        <p class="star-rating mb-2">
                            {% for i in 1..5 %}
                                {% if i <= avis.note %}★{% else %}☆{% endif %}
                            {% endfor %}
                        </p>
                        <p style="color: var(--text-secondary);">{{ avis.commentaire }}</p>
                        <p class="caption-meta mb-3">
                            Commande : {{ avis.commande.numeroCommande }} —
                            Client : {{ avis.commande.utilisateur.prenom }} {{ avis.commande.utilisateur.nom }}
                        </p>

                        <form method="post" action="{{ path('app_espace_employe_avis_valider', {id: avis.id}) }}" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success">Valider</button>
                        </form>
                        <form method="post" action="{{ path('app_espace_employe_avis_refuser', {id: avis.id}) }}" class="d-inline" onsubmit="return confirm('Voulez-vous vraiment refuser cet avis ?');">
                            <button type="submit" class="btn btn-sm btn-danger">Refuser</button>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
