{% extends 'base.html.twig' %}

{% block title %}Gestion des commandes - Vite & Gourmand{% endblock %}

{% block body %}
    <a href="{{ path('app_espace_employe') }}" class="btn btn-outline-primary mb-4">← Retour à votre espace</a>

    <p class="label-eyebrow">GESTION</p>
    <h1>Les <span style="color: var(--primary-brand);">commandes</span></h1>

    <form method="get" class="row g-3 mb-4 mt-2 bloc-filtres">
        <div class="col-md-4">
            <label for="statut" class="form-label">Filtrer par statut</label>
            <select name="statut" id="statut" class="form-select">
                <option value="">Tous les statuts</option>
                <option value="reçue" {% if statutSelectionne == 'reçue' %}selected{% endif %}>Reçue</option>
                <option value="acceptée"{% if statutSelectionne == 'acceptée' %}selected{% endif %}>Acceptée</option>
                <option value="en préparation" {% if statutSelectionne == 'en préparation' %}selected{% endif %}>En préparation</option>
                <option value="en cours de livraison" {% if statutSelectionne == 'en cours de livraison' %}selected{% endif %}>En cours de livraison</option>
                <option value="livrée" {% if statutSelectionne == 'livrée' %}selected{% endif %}>Livrée</option>
                <option value="en attente du retour de matériel" {% if statutSelectionne == 'en attente du retour de matériel' %}selected{% endif %}>En attente du retour de matériel</option>
                <option value="terminée" {% if statutSelectionne == 'terminée' %}selected{% endif %}>Terminée</option>
                <option value="annulée" {% if statutSelectionne == 'annulée' %}selected{% endif %}>Annulée</option>
            </select>
        </div>

        <div class="col-md-4">
            <label for="client" class="form-label">Rechercher un client</label>
            <input type="text" name="client" id="client" class="form-control" value="{{ clientRecherche }}" placeholder="Nom ou Prénom">
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">Filtrer</button>
        </div>
    </form>

    <div class="table-responsive mt-4" style="background-color: var(--background-card); border-radius: var(--radius-card-avis); border: 1px solid var(--border-soft); padding: var(--spacing-md);">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th class="caption-meta" style="text-transform: uppercase;">Numéro</th>
                    <th class="caption-meta" style="text-transform: uppercase;">Client</th>
                    <th class="caption-meta" style="text-transform: uppercase;">Menu</th>
                    <th class="caption-meta" style="text-transform: uppercase;">Date prestation</th>
                    <th class="caption-meta" style="text-transform: uppercase;">Statut actuel</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for commande in commandes %}
                    <tr>
                        <td style="font-weight: 500;">{{ commande.numeroCommande }}</td>
                        <td style="color: var(--text-secondary);">{{ commande.utilisateur.prenom }} {{ commande.utilisateur.nom }}</td>
                        <td style="color: var(--text-secondary);">{{ commande.menu.titre }}</td>
                        <td style="color: var(--text-secondary);">{{ commande.datePrestation|date('d/m/Y') }}</td>
                        <td>
                            {% if commande.statutHistoriques is not empty %}
                                <span class="badge-verifie">{{ commande.statutHistoriques|last.statut }}</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_espace_employe_commande_gerer', {id: commande.id}) }}" class="btn btn-sm btn-outline-primary">Gérer</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
