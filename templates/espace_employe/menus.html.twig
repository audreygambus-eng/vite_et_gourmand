{% extends 'base.html.twig' %}

{% block title %}Gestion des menus - Vite & Gourmand{% endblock %}

{% block body %}
    <a href="{{ path('app_espace_employe') }}" class="btn btn-outline-primary mb-4">← Retour à votre espace</a>

    <p class="label-eyebrow">GESTION</p>
    <h1>Nos <span style="color: var(--primary-brand);">menus</span></h1>

    <div class="table-responsive mt-4" style="background-color: var(--background-card); border-radius: var(--radius-card-avis); border: 1px solid var(--border-soft); padding: var(--spacing-md);">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th class="caption-meta" style="text-transform: uppercase;">Titre</th>
                    <th class="caption-meta" style="text-transform: uppercase;">Thème</th>
                    <th class="caption-meta" style="text-transform: uppercase;">Régime</th>
                    <th class="caption-meta" style="text-transform: uppercase;">Prix</th>
                    <th class="caption-meta" style="text-transform: uppercase;">Stock</th>
                    <th class="caption-meta" style="text-transform: uppercase;">Statut</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for menu in menus %}
                    <tr>
                        <td style="font-weight: 500;">{{ menu.titre }}</td>
                        <td style="color: var(--text-secondary);">{{ menu.theme.libelle }}</td>
                        <td style="color: var(--text-secondary);">{{ menu.regime.libelle }}</td>
                        <td style="color: var(--primary-brand); font-weight: 700;">{{ menu.prixBase }} €</td>
                        <td style="color: var(--text-secondary);">{{ menu.stockDisponible }}</td>
                        <td>
                            {% if menu.actif %}
                                <span class="badge-confirme">Actif</span>
                            {% else %}
                                <span class="badge bg-secondary">Inactif</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_espace_employe_menu_modifier', {id: menu.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                            <form method="post" action="{{ path('app_espace_employe_menu_supprimer', {id:menu.id})}}" class="d-inline" onsubmit="return confirm('Voulez-vous vraiment désactiver ce menu ?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Désactiver</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
                        
