{% extends 'base.html.twig' %}

{% block title %}Gestion des horaires - Vite & Gourmand{% endblock %}

{% block body %}
    <a href="{{ path('app_espace_employe') }}" class="btn btn-outline-secondary mb-4">← Retour à votre espace</a>

    <p class="label-eyebrow">GESTION</p>
    <h1>Nos <span style="color: var(--primary-brand);">horaires</span></h1>

    <div class="table-responsive mt-4" style="background-color: var(--background-card); border-radius: var(--radius-card-avis); border: 1px solid var(--border-soft); padding: var(--spacing-md);">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th class="caption-meta" style="text-transform: uppercase;">Jour</th>
                    <th class="caption-meta" style="text-transform: uppercase;">Ouverture</th>
                    <th class="caption-meta" style="text-transform: uppercase;">Fermeture</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for horaire in horaires %}
                    <tr>
                        <td style="font-weight: 500;">{{ horaire.jour }}</td>
                        <td style="color: var(--text-secondary);">{{ horaire.heureOuverture }}</td>
                        <td style="color: var(--text-secondary);">{{ horaire.heureFermeture }}</td>
                        <td>
                            <a href="{{ path('app_espace_employe_horaire_modifier', {id: horaire.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}